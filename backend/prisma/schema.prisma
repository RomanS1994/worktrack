generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  EMPLOYEE
}

enum MembershipRole {
  MANAGER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum WorkEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum WeeklySubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  CANCELLED
}

enum CompanySubscriptionStatus {
  INACTIVE
  ACTIVE
  GRACE_PERIOD
  EXPIRED
}

enum SubscriptionPaymentStatus {
  PENDING
  REVIEW_REQUESTED
  PAID
  REJECTED
  OVERDUE
}

model User {
  id                 String    @id
  email              String    @unique
  passwordHash       String
  firstName          String    @default("")
  lastName           String    @default("")
  name               String
  phone              String?   @unique
  profile            Json
  mustChangePassword Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  legacyRole          UserRole @default(EMPLOYEE) @map("role") @ignore
  legacyManagerId     String?  @map("managerId") @ignore
  legacyHourlyRateCzk Decimal  @default(0) @map("hourlyRateCzk") @db.Decimal(10, 2) @ignore

  sessions    Session[]
  memberships CompanyMembership[]
  avatar      UserAvatar?

  @@index([deletedAt])
  @@map("users")
}

model UserAvatar {
  userId      String   @id
  contentType String
  data        Bytes
  hash        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hash])
  @@map("user_avatars")
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Company {
  id                 String   @id
  name               String
  slug               String   @unique
  billingProfile     Json     @default("{}")
  breakMinutes       Int      @default(0)
  standardDailyHours Decimal  @default(8) @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships             CompanyMembership[]
  projects                Project[]
  workEntries             WorkEntry[]
  weeklySubmissions       WeeklySubmission[]
  notifications           Notification[]
  invoices                Invoice[]
  subscription            CompanySubscription?
  subscriptionPayments    SubscriptionPayment[]
  managerTimesheetEntries ManagerTimesheetEntry[]
  salaryAdvances          SalaryAdvance[]
  expenses                CompanyExpense[]
  chatAttachments         ChatAttachment[]

  @@index([slug])
  @@map("companies")
}

model CompanySubscription {
  id                String                   @id
  companyId         String                   @unique
  planCode          String                   @default("TEAM_1_5")
  employeeLimit    Int                      @default(5)
  monthlyPriceCzk   Decimal                  @default(490) @db.Decimal(10, 2)
  status            CompanySubscriptionStatus @default(INACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  gracePeriodEnd     DateTime?
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  billingPeriod      String                   @default("month")
  scheduledPlanCode  String?
  scheduledEmployeeLimit Int?
  scheduledMonthlyPriceCzk Decimal?            @db.Decimal(10, 2)
  scheduledBillingPeriod String?
  scheduledEffectiveAt DateTime?
  scheduledPeriodEnd DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@map("company_subscriptions")
}

model SubscriptionPayment {
  id                String                   @id
  companyId         String
  invoiceNumber     String                   @unique
  planCode          String
  employeeLimit     Int
  changeType        String                   @default("RENEWAL")
  billingPeriod     String                   @default("month")
  amountCzk         Decimal                  @db.Decimal(10, 2)
  currency          String                   @default("CZK")
  variableSymbol    String                   @unique
  periodStart       DateTime
  periodEnd         DateTime
  dueDate           DateTime
  status            SubscriptionPaymentStatus @default(PENDING)
  reviewRequestedAt DateTime?
  paidAt            DateTime?
  rejectedAt        DateTime?
  reviewedByEmail   String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([status, dueDate])
  @@map("subscription_payments")
}

model CompanyMembership {
  id                       String           @id
  companyId                String
  userId                   String
  role                     MembershipRole
  canAccessEmployeeCabinet Boolean          @default(true)
  rateHistory              Json             @default("[]")
  hourlyRateCzk            Decimal?         @db.Decimal(10, 2)
  customerRateCzk          Decimal?         @db.Decimal(10, 2)
  status                   MembershipStatus @default(ACTIVE)
  deletedAt                DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  workEntries                       WorkEntry[]             @relation("EmployeeMembershipWorkEntries")
  weeklySubmissions                 WeeklySubmission[]      @relation("EmployeeMembershipWeeklySubmissions")
  reviewedWeeklySubmissions         WeeklySubmission[]      @relation("ReviewerMembershipWeeklySubmissions")
  notifications                     Notification[]          @relation("RecipientMembershipNotifications")
  invoices                          Invoice[]
  employeeManagerTimesheetEntries   ManagerTimesheetEntry[] @relation("EmployeeManagerTimesheetEntries")
  managerManagerTimesheetEntries    ManagerTimesheetEntry[] @relation("ManagerManagerTimesheetEntries")
  employeeSalaryAdvances            SalaryAdvance[]         @relation("EmployeeSalaryAdvances")
  managerSalaryAdvances             SalaryAdvance[]         @relation("ManagerSalaryAdvances")
  employeeCompanyExpenses           CompanyExpense[]        @relation("EmployeeCompanyExpenses")
  managerCompanyExpenses            CompanyExpense[]        @relation("ManagerCompanyExpenses")
  chatAttachments                   ChatAttachment[]        @relation("ChatAttachmentUploader")

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
  @@index([companyId, deletedAt])
  @@map("company_memberships")
}

model ChatAttachment {
  id                   String   @id
  companyId            String   @map("company_id")
  uploaderMembershipId String   @map("uploader_membership_id")
  messageId            String?  @map("message_id")
  fileName             String   @map("file_name")
  mimeType             String   @map("mime_type")
  fileData             Bytes    @map("file_data")
  createdAt            DateTime @default(now()) @map("created_at")

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploader CompanyMembership @relation("ChatAttachmentUploader", fields: [uploaderMembershipId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([companyId, uploaderMembershipId, createdAt])
  @@map("chat_attachments")
}

model Project {
  id          String   @id
  companyId   String
  name        String
  address     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workEntries             WorkEntry[]
  managerTimesheetEntries ManagerTimesheetEntry[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("projects")
}

model WorkEntry {
  id                   String          @id
  companyId            String
  employeeMembershipId String
  projectId            String
  weeklySubmissionId   String?
  workDate             DateTime
  hours                Decimal         @db.Decimal(5, 2)
  hourlyRateCzk        Decimal?        @db.Decimal(10, 2)
  customerRateCzk      Decimal?        @db.Decimal(10, 2)
  grossHours           Decimal?        @db.Decimal(5, 2)
  breakMinutes         Int             @default(0)
  startTime            String?
  endTime              String?
  note                 String?
  status               WorkEntryStatus @default(DRAFT)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  legacyEmployeeId String? @map("employeeId") @ignore

  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeMembership CompanyMembership @relation("EmployeeMembershipWorkEntries", fields: [employeeMembershipId], references: [id], onDelete: Cascade)
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  weeklySubmission   WeeklySubmission? @relation(fields: [weeklySubmissionId], references: [id], onDelete: SetNull)
  invoiceItems       InvoiceItem[]

  @@unique([employeeMembershipId, projectId, workDate])
  @@index([companyId])
  @@index([companyId, status, workDate])
  @@index([employeeMembershipId])
  @@index([employeeMembershipId, workDate])
  @@index([projectId])
  @@index([weeklySubmissionId])
  @@index([status])
  @@map("work_entries")
}

model ManagerTimesheetEntry {
  id                   String   @id
  companyId            String
  employeeMembershipId String
  managerMembershipId  String
  workDate             DateTime @db.Date
  hours                Decimal? @db.Decimal(5, 2)
  breakMinutes         Int?
  hourlyRateCzk        Decimal? @db.Decimal(10, 2)
  customerRateCzk      Decimal? @db.Decimal(10, 2)
  projectId            String?
  note                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeMembership CompanyMembership @relation("EmployeeManagerTimesheetEntries", fields: [employeeMembershipId], references: [id], onDelete: Cascade)
  managerMembership  CompanyMembership @relation("ManagerManagerTimesheetEntries", fields: [managerMembershipId], references: [id], onDelete: Cascade)
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([employeeMembershipId, workDate])
  @@index([companyId, workDate])
  @@index([managerMembershipId])
  @@map("manager_timesheet_entries")
}

model SalaryAdvance {
  id                   String   @id
  companyId            String
  employeeMembershipId String
  managerMembershipId  String
  amountCzk            Decimal  @db.Decimal(12, 2)
  paidAt               DateTime @db.Date
  note                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeMembership CompanyMembership @relation("EmployeeSalaryAdvances", fields: [employeeMembershipId], references: [id], onDelete: Cascade)
  managerMembership  CompanyMembership @relation("ManagerSalaryAdvances", fields: [managerMembershipId], references: [id], onDelete: Cascade)

  @@index([companyId, paidAt])
  @@index([employeeMembershipId, paidAt])
  @@index([managerMembershipId])
  @@map("salary_advances")
}

model CompanyExpense {
  id                   String   @id
  companyId            String
  employeeMembershipId String?
  managerMembershipId  String
  amountCzk            Decimal  @db.Decimal(12, 2)
  spentAt              DateTime @db.Date
  category             String
  note                 String?
  receiptData          Bytes?
  receiptMimeType      String?
  receiptFileName      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeMembership CompanyMembership? @relation("EmployeeCompanyExpenses", fields: [employeeMembershipId], references: [id], onDelete: SetNull)
  managerMembership  CompanyMembership  @relation("ManagerCompanyExpenses", fields: [managerMembershipId], references: [id], onDelete: Cascade)

  @@index([companyId, spentAt])
  @@index([employeeMembershipId])
  @@index([managerMembershipId])
  @@index([companyId, category])
  @@map("company_expenses")
}

model WeeklySubmission {
  id                     String                  @id
  companyId              String
  employeeMembershipId   String
  reviewedByMembershipId String?
  weekStart              DateTime
  weekEnd                DateTime
  status                 WeeklySubmissionStatus @default(DRAFT)
  submittedAt            DateTime?
  reviewedAt             DateTime?
  rejectionReason        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  legacyEmployeeId String? @map("employeeId") @ignore
  legacyManagerId  String? @map("managerId") @ignore

  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeMembership   CompanyMembership @relation("EmployeeMembershipWeeklySubmissions", fields: [employeeMembershipId], references: [id], onDelete: Cascade)
  reviewedByMembership CompanyMembership? @relation("ReviewerMembershipWeeklySubmissions", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  workEntries          WorkEntry[]

  @@unique([employeeMembershipId, weekStart])
  @@index([companyId])
  @@index([companyId, status, weekStart])
  @@index([employeeMembershipId])
  @@index([reviewedByMembershipId])
  @@index([status])
  @@index([weekStart])
  @@map("weekly_submissions")
}

model Invoice {
  id                   String        @id
  companyId            String
  employeeMembershipId String
  invoiceNumber        String
  periodStart          DateTime
  periodEnd            DateTime
  issueDate            DateTime
  dueDate              DateTime
  currency             String        @default("CZK")
  hourlyRate           Decimal       @db.Decimal(10, 2)
  totalHours           Decimal       @db.Decimal(8, 2)
  subtotal             Decimal       @db.Decimal(12, 2)
  status               InvoiceStatus @default(DRAFT)
  sellerSnapshot       Json
  buyerSnapshot        Json
  sentAt               DateTime?
  viewedAt              DateTime?
  paidAt                DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeMembership CompanyMembership @relation(fields: [employeeMembershipId], references: [id], onDelete: Cascade)
  items              InvoiceItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([employeeMembershipId, periodStart])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id
  invoiceId   String
  workEntryId String
  description String
  workDate    DateTime
  hours       Decimal  @db.Decimal(5, 2)
  hourlyRate  Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)

  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  workEntry WorkEntry @relation(fields: [workEntryId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, workEntryId])
  @@index([workEntryId])
  @@map("invoice_items")
}

model Notification {
  id                    String   @id
  companyId             String
  recipientMembershipId String
  type                  String
  title                 String
  message               String
  href                  String?
  readAt                DateTime?
  createdAt              DateTime @default(now())

  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipientMembership CompanyMembership @relation("RecipientMembershipNotifications", fields: [recipientMembershipId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([recipientMembershipId, createdAt])
  @@index([recipientMembershipId, readAt])
  @@map("notifications")
}

model AuditLog {
  id           String   @id
  action       String
  actorUserId  String?
  targetUserId String?
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
