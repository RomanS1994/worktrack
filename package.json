{
  "name": "worktrack",
  "private": true,
  "version": "1.0.0",
  "description": "Work hours manager with React frontend and Prisma/PostgreSQL backend",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.js",
    "dev:client": "vite",
    "dev:server": "npm --prefix backend run dev",
    "db:generate": "node backend/tools/prisma-postinstall.js",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "hooks:install": "node tools/install-git-hooks.js",
    "create:manager": "node backend/tools/create-manager.js",
    "create:employee": "node backend/tools/create-employee.js",
    "import:timesheet": "node backend/tools/import-month-timesheet.js",
    "import:manager-timesheet": "node backend/tools/import-manager-timesheet.js",
    "prepare": "node tools/install-git-hooks.js",
    "postinstall": "node backend/tools/prisma-postinstall.js",
    "secrets:check": "node tools/check-secrets.js",
    "i18n:check": "node tools/check-i18n.js",
    "build:web": "npm run i18n:check && vite build --config vite.config.js",
    "build": "npm run db:generate && npm run build:web",
    "verify": "npm --prefix backend test && npm run build:web && node tools/audit-production.js && npm run secrets:check",
    "preview": "vite preview",
    "smoke:production": "node tools/production-smoke.js",
    "start": "node tools/render-start.js",
    "start:server": "npm --prefix backend run start"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "postcss": "^8.4.41",
    "postcss-sort-media-queries": "^5.2.0",
    "prisma": "^6.19.3",
    "vite": "^5.4.6"
  },
  "author": "Roman Stryzhka rstrizhko1994@gmail.com",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@reduxjs/toolkit": "^2.11.2",
    "lucide-static": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-mobile-picker": "^1.2.0",
    "react-redux": "^2.11.2",
    "react-router-dom": "7.18.2",
    "vite-plugin-full-reload": "^1.2.0",
    "vite-plugin-html-inject": "^1.1.2"
  }
}
